#!/usr/bin/env bash
# The official image's entrypoint (owner decisions 77, 87). Two modes:
#
#   (no command) or `schedule`  Scheduled, the default: Supercronic runs the
#                               crontab l3io-wpbackup-crontab builds.
#   anything else               One-shot: `docker run IMAGE backup` is
#                               `wpbackup2 backup`, and so is
#                               `docker run IMAGE wpbackup2 backup`. The first
#                               argument is run as a command only when it names
#                               an executable on PATH (`sh`, `sleep`); otherwise
#                               it goes to wpbackup2. tests/sidecar/run.sh checks
#                               that no wpbackup2 subcommand names an executable
#                               in the image.
#
# Which user (owner decision 87). The image never changes the owner of
# anything: it runs as the user it is given, and a folder that user cannot
# use is refused with the fix, which is the operator's to apply.
#
#   Started as root (the default)  PUID:PGID, 33:33 (www-data in the official
#                                  `wordpress` image) when unset. One-shot: the
#                                  command runs as PUID:PGID (setpriv). Scheduled:
#                                  the base image's s6 init (/init) starts;
#                                  init-wpbackup-config checks the folders and
#                                  builds the crontab, and svc-wpbackup-schedule
#                                  runs Supercronic, both as PUID:PGID
#                                  (l3io-wpbackup-scheduler). PUID=0 keeps root;
#                                  wpbackup2 then runs a backup, restore or
#                                  prune as the Site Root's owner itself (owner
#                                  decisions 58, 67).
#   Started as another user        Docker's --user (compose `user:`): that user,
#                                  in both modes, without s6 (it needs root):
#                                  the scheduled mode runs
#                                  `l3io-wpbackup-scheduler run`, which checks,
#                                  builds the crontab and execs Supercronic.
#                                  PUID/PGID, when set, must name that user:
#                                  a container not started as root cannot switch.
set -Eeuo pipefail

die() { echo "l3io-wpbackup-entrypoint: $*" >&2; exit 2; }

schedule=0
[[ $# == 0 || $1 == schedule ]] && schedule=1
uid=$(id -u)
gid=$(id -g)

if [[ $uid == 0 ]]; then
    puid=${PUID:-33}
    pgid=${PGID:-33}
    [[ $puid =~ ^[0-9]+$ && $pgid =~ ^[0-9]+$ ]] || die "PUID and PGID must be numeric ids"
    # The s6 init and every script after it read these from the environment.
    export PUID=$puid PGID=$pgid
    if (( schedule )); then
        exec /init
    fi
    if [[ $puid != 0 ]]; then
        exec setpriv --reuid="$puid" --regid="$pgid" --clear-groups -- "$0" "$@"
    fi
else
    if [[ -n ${PUID:-} && $PUID != "$uid" ]] || [[ -n ${PGID:-} && $PGID != "$gid" ]]; then
        die "the container runs as uid $uid:$gid (Docker --user or compose user:), but PUID/PGID ask for ${PUID:-$uid}:${PGID:-$gid}; a container not started as root cannot switch users. Unset PUID/PGID, set them to $uid:$gid, or start the container as root (no --user) so it runs as PUID:PGID"
    fi
    if (( schedule )); then
        exec l3io-wpbackup-scheduler run
    fi
fi

if [[ $1 != -* ]] && command -v -- "$1" >/dev/null 2>&1; then
    exec "$@"
fi
exec wpbackup2 "$@"
