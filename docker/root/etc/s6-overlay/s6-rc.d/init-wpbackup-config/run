#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# Scheduled mode, once at start, when the container started as root (the s6
# path; l3io-wpbackup-entrypoint). As PUID:PGID (33:33 by default; PUID=0
# stays root): check the folders the scheduled jobs need, then build and check
# the crontab Supercronic runs (l3io-wpbackup-scheduler prepare). Nothing's
# owner is changed (owner decision 87). A failure here stops the container
# (S6_BEHAVIOUR_IF_STAGE2_FAILS=2), so a folder the jobs cannot use, or a bad
# schedule, is reported at start, not at the first missed backup.
set -Eeuo pipefail
exec l3io-wpbackup-scheduler prepare
