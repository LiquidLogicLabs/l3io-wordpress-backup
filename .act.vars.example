# act variables — copy to .act.vars (make act-init) and adjust.

# Marks the run as local. Workflows gate on vars.LOCAL_ACT, never env.ACT:
# env.ACT does not work in a job-level `if:`, and Gitea's runners also set
# ACT=true, which would make a real CI run mistake itself for a local one.
LOCAL_ACT=1

# DB_HOST is deliberately NOT set. It must stay a loopback address (wpbackup2
# treats any other host as remote). Under act, ci.yml's `test` job runs in its
# own container and a step forwards 127.0.0.1:3306 to its leg's database.
#
# ACT_JOB_IMAGE (optional): the image that `test` job runs in under act.
# Defaults to ghcr.io/catthehacker/ubuntu:act-latest, what ~/.actrc maps
# ubuntu-latest to; set it if your ~/.actrc maps ubuntu-latest elsewhere.
# ACT_JOB_IMAGE=

# Leave empty to skip the internal registry mirror job.
PYPI_CUSTOM_URL=
